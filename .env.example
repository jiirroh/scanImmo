# =====================================================================
# Configuration de la Veille Immobilière Automatisée
# Copiez ce fichier vers .env et renseignez vos véritables valeurs :
# cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# 1. RAPPORT QUOTIDIEN PAR E-MAIL (100% GRATUIT VIA SMTP)
# ---------------------------------------------------------------------
# Serveur SMTP (ex: smtp.gmail.com pour Gmail, smtp-mail.outlook.com pour Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Votre adresse e-mail d'expédition
SMTP_USER=votre.email@gmail.com

# Mot de passe d'application (Pour Gmail : Compte Google -> Sécurité -> Mots de passe des applications)
SMTP_PASSWORD=abcd efgh ijkl mnop

# Adresse e-mail qui recevra le rapport quotidien
EMAIL_TO=votre.email@gmail.com

# Adresse expéditeur affichée (optionnel, par défaut identique à SMTP_USER)
EMAIL_FROM=Veille Immobilière <votre.email@gmail.com>

# ---------------------------------------------------------------------
# 2. ALERTES TELEGRAM (OPTIONNEL / COMPLÉMENTAIRE)
# ---------------------------------------------------------------------
# Jeton d'API Telegram obtenu auprès de @BotFather
TELEGRAM_TOKEN=

# Identifiant numérique de chat obtenu auprès de @userinfobot
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# 3. RECHERCHES & PARAMÈTRES RÉSEAU
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
REQUEST_TIMEOUT=15

# URLs de recherche à surveiller séparées par une virgule
SEARCH_URLS=https://www.pap.fr/annonce/vente-maisons-rennes-35000-g43564,https://www.paruvendu.fr/immobilier/vente/maison/rennes-35000/?p=1
